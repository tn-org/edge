# ===========================================
# edge (Traefik reverse proxy, CrowdSec, host maintenance)
# ===========================================
# Everything that differs per host goes here. The repo itself contains no host-specific
# value and no application name, so the same repo can be cloned onto any host as-is.
# The ops console belongs to the application repo and runs at /app/<slug>/console on the
# server; its own .env.example is the reference for its keys.

# ===========================================
# Environment (production / staging / local)
# ===========================================
# The Makefile switches on sudo and the server-only guard whenever this is not "local".
# scripts/*.sh use it the same way.
APP_ENV=local

# ===========================================
# Shared network
# ===========================================
# Name of the single docker network on the host. edge and every application's compose
# file join it as external, and Traefik connects to the container IP on this network.
# Change it only on a host where the name collides with an existing network.
EDGE_NETWORK=edge

# ===========================================
# Optional services (docker compose profiles)
# ===========================================
# Comma-separated list of compose profiles to include in make up / make update.
# Available profiles (currently just one):
#   db — shared PostgreSQL instance (see "Shared database" in the README)
# Empty (the default) runs the proxy stack only; a host whose databases live in a
# managed service (RDS etc.) leaves it empty. On a workstation make db-up starts the
# database alone regardless of this value.
# Example, for a host that runs its databases in a container:
#   COMPOSE_PROFILES=db
COMPOSE_PROFILES=

# Superuser password of the shared PostgreSQL instance (user "postgres"). Read only when
# the db service starts. Applications never connect as the superuser: each one gets its
# own role and database via make db-create.
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Host-side loopback port of the shared PostgreSQL instance (psql, dumps, restores).
# Change it only on a machine where 5432 is already taken; containers on the shared
# network always reach it as edge-postgres:5432.
POSTGRES_PORT=5432

# ===========================================
# Certificates
# ===========================================
# Where the TLS certificates come from:
#   letsencrypt  Traefik's ACME resolver obtains and renews them over HTTP-01 (default)
#   origin-ca    certificates placed by hand in certs/, for a host that is only reachable
#                through the Cloudflare proxy
# With origin-ca, issue the certificate in the Cloudflare dashboard under
# SSL/TLS > Origin Server > Create Certificate (it covers example.com and *.example.com in
# one and is valid for 15 years), then save the two halves on this host as
# certs/<apex>.pem and certs/<apex>.key and run make render. scripts/render-config.sh lists
# every pair it finds in traefik/dynamic/generated-tls.yml, and Traefik picks one per
# connection by SNI, so several apexes can share a host. Nothing renews them.
# Port 80 and the redirect to HTTPS stay in place in both modes.
# Going back is a change of this one key: the ACME store is never deleted.
EDGE_TLS_MODE=letsencrypt

# Registration address for Let's Encrypt (where expiry notices go).
# scripts/render-config.sh substitutes it into traefik/generated/traefik.yml, because
# Traefik does not expand environment variables inside its static config file, so the
# value cannot be passed to the container directly.
ACME_EMAIL=your-email@example.com

# ===========================================
# Blocking (CrowdSec)
# ===========================================
# Whether this host runs CrowdSec:
#   auto  follow EDGE_TLS_MODE (default). With letsencrypt the container runs and the
#         bouncer middleware applies its decisions to every router on the websecure
#         entrypoint. With origin-ca (behind Cloudflare) it does not run.
#   off   do not run it, whatever EDGE_TLS_MODE says. For a host whose application's
#         legitimate traffic trips the HTTP detection scenarios and cannot be changed yet.
# Not running means: no container, no bouncer in the default middleware list, no blocking
# report timer, and no blocking state published to the ops console. The rate limit, the
# concurrency limit and the security headers are Traefik's own and stay in place.
# There is no "on": no host needs blocking behind Cloudflare. Add it if one ever does.
EDGE_CROWDSEC=auto

# Shared secret the Traefik bouncer plugin presents to the CrowdSec LAPI.
# At startup compose registers it with CrowdSec as BOUNCER_KEY_traefik, and
# scripts/render-config.sh writes the same value to traefik/generated/lapi-key.
# Compose fails to start when it is unset, so blocking is never silently inactive.
# Still required when CrowdSec does not run (origin-ca or EDGE_CROWDSEC=off; nothing
# reads it then), so that bringing blocking back is never a hunt for a lost secret.
# Generate with: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=

# ===========================================
# Traefik dashboard (optional)
# ===========================================
# Publish the dashboard at this FQDN over HTTPS behind basic auth (rendered into
# traefik/dynamic/generated-dashboard.yml by scripts/render-config.sh). Point a DNS
# record at this host first. Both keys empty (the default) = no route exists and the
# dashboard is unreachable from anywhere.
DASHBOARD_HOST=
# One htpasswd line ("user:hash"). Generate the hash with:
#   openssl passwd -apr1 'your-password'
# The hash contains $ and .env is sourced by bash. make env quotes it automatically;
# when editing this file by hand, single-quote the value: DASHBOARD_AUTH='admin:$apr1$...'
DASHBOARD_AUTH=

# ===========================================
# Ops console
# ===========================================
# Nothing to configure. scripts/notify.sh and scripts/report.sh write notifications, state
# snapshots and operation results into sync/ in this repo, and the ops console reads that
# directory (it mounts it from its own compose file). A host with no console writes the
# same files and nobody reads them, so there is no key to set either way.
