# ===========================================
# edge（Traefik リバースプロキシ・CrowdSec・ホスト保守）
# ===========================================
# ホストごとに違う値はすべてここに出す。repo 本体にはホスト固有の値もプロジェクト名も
# 一切書かない（同じ repo をどのホストにも clone してそのまま使う）。
# 運用コンソール（console）は各プロジェクトの repo が持ち、サーバー上は
# /app/<slug>/console で動く。console 用のキーはそちらの .env.example が正。

# ===========================================
# 環境設定（production / staging / local）
# ===========================================
# Makefile が local 以外で sudo・server 専用ガードに自動切替。scripts/*.sh も実行場所判定に使う
APP_ENV=local

# ===========================================
# 共有ネットワーク
# ===========================================
# ホストに 1 本だけ置く docker network の名前。edge と各プロジェクトの compose が
# この名前へ external で参加し、Traefik もこのネットワーク側の IP へ繋ぐ。
# 変えるのは既存の別ネットワークと名前がぶつかるホストだけ（既定のままでよい）
EDGE_NETWORK=edge

# ===========================================
# 証明書
# ===========================================
# Let's Encrypt の登録メールアドレス（期限切れ通知の宛先）。
# scripts/render-config.sh が traefik/generated/traefik.yml へ埋め込む。
# Traefik の静的設定はファイル内で環境変数を展開しないため、コンテナへ直接は渡せない
ACME_EMAIL=your-email@example.com

# ===========================================
# 遮断（CrowdSec）
# ===========================================
# Traefik の bouncer プラグインが CrowdSec の LAPI へ渡す共有シークレット。
# compose が起動時に BOUNCER_KEY_traefik として CrowdSec へ登録し、
# scripts/render-config.sh が同じ値を traefik/generated/lapi-key へ書き出す。
# 未設定だと compose がエラーで止まる（黙って遮断が効かない状態を作らないため）。
# 生成例: openssl rand -hex 32
CROWDSEC_BOUNCER_KEY=

# ===========================================
# 運用通知ハブへの送信（scripts/notify.sh・scripts/report.sh）
# ===========================================
# 内部通信の共有シークレット。同じホストの main / console / ホスト層で同一の 1 値。
# ホストからは通知ハブの /internal/notify 等へ送るときに付与する。
# 未設定だとハブ側が fail-closed で弾くため、ホストからの通知・同期が全て届かなくなる。
# 生成例: openssl rand -hex 32
INTERNAL_TOKEN=

# 通知ハブ（console）の向き先。既定は同一ホストの console（loopback 限定で publish 済み）。
# console を別ホストへ置いたときだけ書き換える
OPS_NOTIFY_URL=http://127.0.0.1:9090
