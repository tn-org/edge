# Environment
.env

# Config rendered from .env (Traefik static config, CrowdSec LAPI key)
traefik/generated/

# Dashboard route rendered from .env (DASHBOARD_HOST / DASHBOARD_AUTH)
traefik/dynamic/generated-dashboard.yml

# ACME certificate store (secret; Traefik creates acme.json with mode 600)
traefik/acme/

# Certificates placed by hand (EDGE_TLS_MODE=origin-ca). Private keys: never commit them
certs/

# TLS config rendered from certs/ (EDGE_TLS_MODE=origin-ca)
traefik/dynamic/generated-tls.yml

# Allowlisted IPs and the CrowdSec whitelist built from them (operational state)
crowdsec/generated/

# Config hash used by deploy-host.sh, and the pending-reboot timestamp
.state/

# The file channel to the ops console (state snapshots, events, operation requests)
sync/

# Logs
logs/

# Python bytecode (report.sh imports scripts/crowdsec_json.py)
__pycache__/

# OS
.DS_Store
