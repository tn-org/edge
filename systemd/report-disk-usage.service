# Daily record of disk usage per directory
# Installed to: /etc/systemd/system/report-disk-usage.service
# setup-disk-usage.sh replaces /path/to/edge with the real path.

[Unit]
Description=Record disk usage per directory
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/path/to/edge
EnvironmentFile=-/path/to/edge/.env
ExecStart=/path/to/edge/scripts/report.sh disk-usage
# It walks the whole disk, so lower the priority to stay out of the way
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=600
