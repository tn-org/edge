# Daily certificate expiry report
# Installed to: /etc/systemd/system/report-certs.service
# setup-certs.sh replaces /path/to/edge with the real path.

[Unit]
Description=Certificate expiry report
OnFailure=notify-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/path/to/edge
EnvironmentFile=-/path/to/edge/.env
ExecStart=/path/to/edge/scripts/report.sh certs
TimeoutStartSec=300
